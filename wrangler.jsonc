{
  // VERITAS LIFE on Cloudflare Workers (free plan): game files from the edge, game server in one Durable Object.
  "name": "veritas-life",
  "main": "cf/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node build.js && node cf/prepare.js" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ws"] },
  "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "Game" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],
  "vars": { "PAYMENTS_MODE": "test", "ON_CLOUDFLARE": "1" },
  "observability": { "enabled": true }
}
